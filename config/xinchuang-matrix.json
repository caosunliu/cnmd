      "features": ["NEON", "SVE"],
      "qemu_platform": "linux/arm64"
    },
    "arm64_kunpeng": {
      "name": "鲲鹏ARM64",
      "vendor": "华为",
      "cross_compile": "aarch64-linux-gnu-",
      "host": "aarch64-linux-gnu",
      "features": ["NEON", "SVE"],
      "qemu_platform": "linux/arm64"
    },
    "x86_64_hygon": {
      "name": "海光x86_64",
