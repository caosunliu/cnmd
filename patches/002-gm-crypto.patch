+/*
+ * sm2.c
+ *
+ * SM2椭圆曲线公钥密码算法实现
+ * 基于GmSSL库
+ */
+
+#include "postgres.h"
+#include "fmgr.h"
+#include "utils/builtins.h"
+
+#ifdef HAVE_GMSSL
+#include <gmssl/sm2.h>
+#include <gmssl/rand.h>
+#include <gmssl/err.h>
+
+PG_FUNCTION_INFO_V1(sm2_keygen);
+PG_FUNCTION_INFO_V1(sm2_sign);
+PG_FUNCTION_INFO_V1(sm2_verify);
+PG_FUNCTION_INFO_V1(sm2_encrypt);
+PG_FUNCTION_INFO_V1(sm2_decrypt);
+
+/*
+ * SM2密钥生成
+ */
+Datum
+sm2_keygen(PG_FUNCTION_ARGS)
+{
+    SM2_KEY key;
+    uint8_t public_key[64];
+    uint8_t private_key[32];
+    size_t len;
+
+    if (sm2_generate_key(&key) != 1)
+        ereport(ERROR,
+                (errmsg("SM2密钥生成失败")));
+
+    len = sizeof(public_key);
+    if (sm2_public_key_to_bytes(&key, public_key, &len) != 1)
+        ereport(ERROR,
+                (errmsg("SM2公钥导出失败")));
+
+    len = sizeof(private_key);
+    if (sm2_private_key_to_bytes(&key, private_key, &len) != 1)
+        ereport(ERROR,
+                (errmsg("SM2私钥导出失败")));
+
+    /* 返回公钥和私钥 */
+    bytea *result = (bytea *) palloc(VARHDRSZ + 96);
+    SET_VARSIZE(result, VARHDRSZ + 96);
+    memcpy(VARDATA(result), public_key, 64);
+    memcpy(VARDATA(result) + 64, private_key, 32);
+
+    PG_RETURN_BYTEA_P(result);
+}
+
+/*
+ * SM2签名
+ */
+Datum
+sm2_sign(PG_FUNCTION_ARGS)
+{
+    bytea *message = PG_GETARG_BYTEA_PP(0);
+    bytea *private_key_bytes = PG_GETARG_BYTEA_PP(1);
+    SM2_SIGN_CTX sign_ctx;
+    uint8_t sig[64];
+    size_t siglen;
+
+    SM2_KEY key;
+    if (sm2_private_key_from_bytes(&key, VARDATA_ANY(private_key_bytes)) != 1)
+        ereport(ERROR,
+                (errmsg("SM2私钥无效")));
+
+    if (sm2_sign_ctx_init(&sign_ctx, &key) != 1)
+        ereport(ERROR,
+                (errmsg("SM2签名上下文初始化失败")));
+
+    if (sm2_sign_update(&sign_ctx, VARDATA_ANY(message), VARSIZE_ANY_EXHDR(message)) != 1)
+        ereport(ERROR,
+                (errmsg("SM2签名更新失败")));
+
+    siglen = sizeof(sig);
+    if (sm2_sign_finish(&sign_ctx, sig, &siglen) != 1)
+        ereport(ERROR,
+                (errmsg("SM2签名完成失败")));
+
+    bytea *result = (bytea *) palloc(VARHDRSZ + siglen);
+    SET_VARSIZE(result, VARHDRSZ + siglen);
+    memcpy(VARDATA(result), sig, siglen);
+
+    PG_RETURN_BYTEA_P(result);
+}
+
+/*
+ * SM2验签
+ */
+Datum
+sm2_verify(PG_FUNCTION_ARGS)
+{
+    bytea *signature = PG_GETARG_BYTEA_PP(0);
+    bytea *message = PG_GETARG_BYTEA_PP(1);
+    bytea *public_key_bytes = PG_GETARG_BYTEA_PP(2);
+    SM2_SIGN_CTX verify_ctx;
+    SM2_KEY key;
+    int result;
+
+    if (sm2_public_key_from_bytes(&key, VARDATA_ANY(public_key_bytes)) != 1)
+        ereport(ERROR,
+                (errmsg("SM2公钥无效")));
+
+    if (sm2_sign_ctx_init(&verify_ctx, &key) != 1)
+        ereport(ERROR,
+                (errmsg("SM2验签上下文初始化失败")));
+
+    if (sm2_sign_update(&verify_ctx, VARDATA_ANY(message), VARSIZE_ANY_EXHDR(message)) != 1)
+        ereport(ERROR,
+                (errmsg("SM2验签更新失败")));
+
+    result = sm2_sign_verify(&verify_ctx, VARDATA_ANY(signature), VARSIZE_ANY_EXHDR(signature));
+
+    PG_RETURN_BOOL(result == 1);
+}
+
+#else /* !HAVE_GMSSL */
+
+/*
+ * 未启用GmSSL时的桩函数
+ */
+Datum
+sm2_keygen(PG_FUNCTION_ARGS)
+{
+    ereport(ERROR,
+            (errmsg("SM2算法需要GmSSL支持")));
+    PG_RETURN_NULL();
+}
+
+Datum
+sm2_sign(PG_FUNCTION_ARGS)
+{
+    ereport(ERROR,
+            (errmsg("SM2算法需要GmSSL支持")));
+    PG_RETURN_NULL();
+}
+
+Datum
+sm2_verify(PG_FUNCTION_ARGS)
+{
+    ereport(ERROR,
+            (errmsg("SM2算法需要GmSSL支持")));
+    PG_RETURN_NULL();
+}
+
+#endif /* HAVE_GMSSL */
