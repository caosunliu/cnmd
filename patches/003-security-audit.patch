@@ -0,0 +1,80 @@
+/*
+ * cnmd_security.h
+ *
+ * CNMD安全审计头文件
+ */
+
+#ifndef CNMD_SECURITY_H
+#define CNMD_SECURITY_H
+
+#include "postgres.h"
+#include "utils/guc.h"
+
+/* 审计事件类型 */
+typedef enum {
+    AUDIT_EVENT_CONNECT = 0,        /* 连接事件 */
+    AUDIT_EVENT_DISCONNECT,         /* 断开连接事件 */
+    AUDIT_EVENT_DDL,                /* DDL操作事件 */
+    AUDIT_EVENT_DML,                /* DML操作事件 */
+    AUDIT_EVENT_DCL,                /* DCL操作事件 */
+    AUDIT_EVENT_SECURITY,           /* 安全事件 */
+    AUDIT_EVENT_SYSTEM,             /* 系统事件 */
+    AUDIT_EVENT_MAX
+} AuditEventType;
+
+/* 审计日志配置 */
+extern bool audit_log_enabled;
+extern bool audit_log_relation_enabled;
+extern char *audit_log_file;
+extern char *audit_log_statement;
+
+/* 审计函数声明 */
+extern void audit_log_init(void);
+extern void audit_log_cleanup(void);
+extern void audit_log_event(AuditEventType event_type, 
+                            const char *user, 
+                            const char *database,
+                            const char *client_addr,
+                            const char *command);
+extern void audit_log_connect(const char *user, 
+                              const char *database,
+                              const char *client_addr);
+extern void audit_log_disconnect(const char *user, 
+                                 const char *database,
+                                 const char *client_addr);
+extern void audit_log_statement(const char *user, 
+                                const char *database,
+                                const char *client_addr,
+                                const char *command);
+extern void audit_log_security(const char *user, 
+                               const char *database,
+                               const char *client_addr,
+                               const char *event);
+
+/* 密码策略配置 */
+extern int password_min_length;
+extern int password_max_age;
+extern int password_history;
+extern int password_lock_threshold;
+extern int password_lock_duration;
+
+/* 密码策略函数 */
+extern bool password_check_policy(const char *password, 
+                                  const char *username);
+extern bool password_check_history(const char *password, 
+                                  Oid roleid);
+extern void password_record_history(const char *password, 
+                                   Oid roleid);
+extern bool password_check_lock(const char *username);
+extern void password_record_login(const char *username);
+
+/* 会话管理配置 */
+extern int statement_timeout;
+extern int idle_in_transaction_session_timeout;
+extern int max_connections_per_user;
+
+/* 会话管理函数 */
+extern void session_init(void);
+extern void session_cleanup(void);
+extern bool session_check_limit(const char *username);
+extern void session_record(const char *username);
+extern void session_remove(const char *username);
+
+#endif /* CNMD_SECURITY_H */
