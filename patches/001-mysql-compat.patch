diff --git a/src/include/cnmd/cnmd_compat.h b/src/include/cnmd/cnmd_compat.h
new file mode 100644
index 0000000..1234567
--- /dev/null
+++ b/src/include/cnmd/cnmd_compat.h
@@ -0,0 +1,50 @@
+/*
+ * cnmd_compat.h
+ *
+ * CNMD MySQL兼容模式头文件
+ */
+
+#ifndef CNMD_COMPAT_H
+#define CNMD_COMPAT_H
+
+#include "postgres.h"
+
+/* MySQL兼容模式开关 */
+typedef enum {
+    CNMD_COMPAT_NONE = 0,
+    CNMD_COMPAT_MYSQL = 1,
+    CNMD_COMPAT_ORACLE = 2
+} CNMDCompatMode;
+
+extern bool cnmd_compatibility_mode;
+
+/* 函数声明 */
+extern bool cnmd_compat_mysql_mode(void);
+extern RawStmt *cnmd_transform_mysql_stmt(RawStmt *stmt);
+extern void cnmd_compat_init(void);
+extern void cnmd_compat_cleanup(void);
+
+/* MySQL语法转换函数 */
+extern Node *cnmd_transform_show_tables(ParseState *pstate);
+extern Node *cnmd_transform_describe_table(ParseState *pstate, char *tablename);
+extern Node *cnmd_transform_select_at_variable(ParseState *pstate, char *varname);
+extern Node *cnmd_transform_insert_ignore(ParseState *pstate, InsertStmt *stmt);
+extern Node *cnmd_transform_replace_into(ParseState *pstate, InsertStmt *stmt);
+extern Node *cnmd_transform_limit_offset(ParseState *pstate, SelectStmt *stmt);
+
+/* MySQL函数映射 */
+extern Node *cnmd_transform_mysql_function(Oid funcid, List *args);
+
+/* MySQL数据类型映射 */
+extern Oid cnmd_map_mysql_datatype(const char *typename);
+
+/* MySQL认证方式 */
+extern bool cnmd_mysql_authenticate(Port *port);
+
+/* 工具函数 */
+extern char *cnmd_get_compat_mode_name(void);
+extern void cnmd_set_compat_mode(const char *mode);
+
+#endif /* CNMD_COMPAT_H */
