# ============================================
# CNMD 信创平台构建 Dockerfile
# 支持: 统信UOS
# ============================================

# 基础镜像 - 统信UOS
FROM uos:latest AS builder-uos

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    make \
    cmake \
    git \
    wget \
    curl \
    pkg-config \
    libreadline-dev \
    zlib1g-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    libsystemd-dev \
    libicu-dev \
    uuid-dev \
    flex \
    bison \
    python3 \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . /build/cnmd
RUN chmod +x /build/cnmd/scripts/*.sh

ENTRYPOINT ["/bin/bash"]
