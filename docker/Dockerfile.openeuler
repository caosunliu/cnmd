# ============================================
# CNMD 信创平台构建 Dockerfile
# 支持: openEuler欧拉
# ============================================

# 基础镜像 - openEuler
FROM openeuler/openeuler:22.03 AS builder-openeuler

# 设置环境变量
ENV LANG=zh_CN.UTF-8
ENV LC_ALL=zh_CN.UTF-8

# 安装构建依赖
RUN yum groupinstall -y "Development Tools" && \
    yum install -y \
    gcc \
    gcc-c++ \
    make \
    cmake \
    git \
    wget \
    curl \
    pkg-config \
    readline-devel \
    zlib-devel \
    openssl-devel \
    libxml2-devel \
    libxslt-devel \
    systemd-devel \
    libuuid-devel \
    flex \
    bison \
    python3 \
    python3-devel && \
    yum clean all

WORKDIR /build
COPY . /build/cnmd
RUN chmod +x /build/cnmd/scripts/*.sh

ENTRYPOINT ["/bin/bash"]
