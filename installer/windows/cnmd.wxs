<?xml version="1.0" encoding="UTF-8"?>
<!--
  CNMD Database WiX Installer Script
  生成 .msi 安装包
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="CNMD"
           Language="2052"
           Version="1.0.0.0"
           Manufacturer="CNMD Team"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="200"
             Compressed="yes"
             InstallScope="perMachine"
             Description="CNMD Database Server"
             Comments="Based on PostgreSQL 18 with Chinese national cryptography support"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 CNMD。" />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="CNMD" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="EnvVarComponent" />
      <ComponentRef Id="InitDbComponent" />
    </Feature>

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- 许可证 -->
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />
  </Product>

  <Fragment>
    <!-- 目录结构 -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="CNMD" />
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="CNMDDataFolder" Name="CNMD" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <!-- 组件 -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <!-- bin 目录 -->
      <Component Id="BinDirComponent" Guid="*">
        <CreateFolder />
        <RemoveFolder Id="RemoveBinDir" On="uninstall" />
      </Component>

      <Component Id="PostgresExe" Guid="*" Win64="yes">
        <File Id="postgres.exe" Source="staging\cnmd\bin\postgres.exe" KeyPath="yes" />
      </Component>
      <Component Id="PsqlExe" Guid="*" Win64="yes">
        <File Id="psql.exe" Source="staging\cnmd\bin\psql.exe" KeyPath="yes" />
      </Component>
      <Component Id="PgCtlExe" Guid="*" Win64="yes">
        <File Id="pg_ctl.exe" Source="staging\cnmd\bin\pg_ctl.exe" KeyPath="yes" />
      </Component>
      <Component Id="InitdbExe" Guid="*" Win64="yes">
        <File Id="initdb.exe" Source="staging\cnmd\bin\initdb.exe" KeyPath="yes" />
      </Component>
      <Component Id="PgDumpExe" Guid="*" Win64="yes">
        <File Id="pg_dump.exe" Source="staging\cnmd\bin\pg_dump.exe" KeyPath="yes" />
      </Component>
      <Component Id="PgRestoreExe" Guid="*" Win64="yes">
        <File Id="pg_restore.exe" Source="staging\cnmd\bin\pg_restore.exe" KeyPath="yes" />
      </Component>
      <Component Id="CreatedbExe" Guid="*" Win64="yes">
        <File Id="createdb.exe" Source="staging\cnmd\bin\createdb.exe" KeyPath="yes" />
      </Component>
      <Component Id="DropdbExe" Guid="*" Win64="yes">
        <File Id="dropdb.exe" Source="staging\cnmd\bin\dropdb.exe" KeyPath="yes" />
      </Component>
      <Component Id="CreateuserExe" Guid="*" Win64="yes">
        <File Id="createuser.exe" Source="staging\cnmd\bin\createuser.exe" KeyPath="yes" />
      </Component>
      <Component Id="DropuserExe" Guid="*" Win64="yes">
        <File Id="dropuser.exe" Source="staging\cnmd\bin\dropuser.exe" KeyPath="yes" />
      </Component>
      <Component Id="PgBasebackupExe" Guid="*" Win64="yes">
        <File Id="pg_basebackup.exe" Source="staging\cnmd\bin\pg_basebackup.exe" KeyPath="yes" />
      </Component>
      <Component Id="PgIsreadyExe" Guid="*" Win64="yes">
        <File Id="pg_isready.exe" Source="staging\cnmd\bin\pg_isready.exe" KeyPath="yes" />
      </Component>

      <!-- DLL 文件 -->
      <Component Id="LibpqDll" Guid="*" Win64="yes">
        <File Id="libpq.dll" Source="staging\cnmd\bin\libpq.dll" KeyPath="yes" />
      </Component>
      <Component Id="PostgresDll" Guid="*" Win64="yes">
        <File Id="libpq.dll_copy" Source="staging\cnmd\bin\libpq.dll" KeyPath="yes" />
      </Component>

      <!-- lib 目录 -->
      <Component Id="LibDirComponent" Guid="*">
        <CreateFolder />
        <RemoveFolder Id="RemoveLibDir" On="uninstall" />
      </Component>
      <Component Id="PostgresLib" Guid="*" Win64="yes">
        <File Id="libpostgres.dll" Source="staging\cnmd\lib\libpostgres.dll" KeyPath="yes" />
      </Component>

      <!-- share 目录 -->
      <Component Id="ShareDirComponent" Guid="*">
        <CreateFolder />
        <RemoveFolder Id="RemoveShareDir" On="uninstall" />
      </Component>

      <!-- data 目录 -->
      <Component Id="DataDirComponent" Guid="*">
        <CreateFolder Directory="CNMDDataFolder" />
        <RemoveFolder Id="RemoveDataDir" On="uninstall" />
      </Component>

      <!-- 配置文件 -->
      <Component Id="PgHbaConf" Guid="*" Win64="yes">
        <File Id="pg_hba.conf" Source="staging\cnmd\share\postgresql\pg_hba.conf.sample" KeyPath="yes" />
      </Component>
      <Component Id="PostgresqlConf" Guid="*" Win64="yes">
        <File Id="postgresql.conf" Source="staging\cnmd\share\postgresql\postgresql.conf.sample" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Windows 服务 -->
    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Guid="*">
      <ServiceInstall Id="CNMDService"
                      Name="cnmd"
                      DisplayName="CNMD Database Server"
                      Description="CNMD Database Server based on PostgreSQL 18"
                      Start="auto"
                      Type="ownProcess"
                      ErrorControl="normal"
                      Wait="yes" />
      <ServiceControl Id="CNMDServiceControl"
                      Name="cnmd"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- 环境变量 -->
    <Component Id="EnvVarComponent" Directory="INSTALLFOLDER" Guid="*">
      <Environment Id="CNMDPath"
                   Name="PATH"
                   Value="[INSTALLFOLDER]bin"
                   Permanent="no"
                   Part="last"
                   Action="set"
                   System="yes" />
      <Environment Id="CNMDHome"
                   Name="CNMD_HOME"
                   Value="[INSTALLFOLDER]"
                   Permanent="no"
                   Action="set"
                   System="yes" />
    </Component>

    <!-- 初始化数据库 -->
    <Component Id="InitDbComponent" Directory="INSTALLFOLDER" Guid="*">
      <CreateFolder />
      <RemoveFolder Id="RemoveInitDbDir" On="uninstall" />
      <CustomAction Id="InitDatabase"
                    FileKey="initdb.exe"
                    ExeCommand='-D "[CommonAppDataFolder]\CNMD\data" -U cnmd --encoding=UTF8 --locale=C'
                    Execute="deferred"
                    Return="check"
                    Impersonate="no" />
      <CustomAction Id="StopService"
                    Property="CNMDService"
                    Execute="deferred"
                    Return="ignore"
                    Impersonate="no"
                    Script="vbscript">
        <![CDATA[
          Set service = GetObject("winmgmts:\\.\root\cimv2").Get("Win32_Service.Name='cnmd'")
          service.StopService
        ]]>
      </CustomAction>
      <CustomAction Id="DeleteService"
                    Property="CNMDService"
                    Execute="deferred"
                    Return="ignore"
                    Impersonate="no"
                    Script="vbscript">
        <![CDATA[
          Set service = GetObject("winmgmts:\\.\root\cimv2").Get("Win32_Service.Name='cnmd'")
          service.Delete
        ]]>
      </CustomAction>

      <InstallExecuteSequence>
        <Custom Action="InitDatabase" After="InstallFiles" />
      </InstallExecuteSequence>
    </Component>
  </Fragment>
</Wix>
